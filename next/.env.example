# Local template for the Next.js app in next/.
# Copy to .env.local (gitignored) or use root `yarn setup`.
# NEXT_PUBLIC_* values are inlined at `next build`. See docs/ENV-next.md.

# config.ts: prefixed with https:// when set (host only, not a full URL).
WEBSITE_URL=localhost:3000
PORT=3000

# Required for production builds (validated by Zod in next/env/validate.ts).
NEXT_PUBLIC_API_URL=http://localhost:1337

# Optional public (sitemap / Turnstile when enabled).
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Strapi draft preview (server-only).
PREVIEW_SECRET=tobemodified

# Build-time image / dev origins (next.config.ts).
DOMAIN=localhost
BACK_PORT=1337
IMAGE_HOSTNAME=localhost:1337
BACKEND_URL=http://localhost:1337

# Contact form (server-only; Web3Forms + Turnstile verify).
TURNSTILE_SECRET_KEY=
CONTACT_EMAIL_ACCESS_KEY=
CONTACT_EMAIL=

# Set to 1 to skip Zod validation (lint/typecheck scripts only; not for real builds).
# SKIP_ENV_VALIDATION=1
