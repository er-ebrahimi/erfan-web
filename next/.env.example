# Local template. Production CI writes next/.env.local from the STUDIOARMAN_ENV_LOCAL secret.
# See docs/DEPLOY-studioarman.md. NEXT_PUBLIC_* values are inlined at `next build`.

# config.ts prefixes https:// when this is set. Prefer a host, not a full URL.
WEBSITE_URL=localhost:3000
PORT=3000

# Strapi origin. Redirects are fetched from ${NEXT_PUBLIC_API_URL}/api/redirections at build time.
NEXT_PUBLIC_API_URL=http://localhost:1337

# Optional. next-sitemap falls back to DOMAIN, then https://example.com.
NEXT_PUBLIC_SITE_URL=

PREVIEW_SECRET=tobemodified

# next.config.mjs image remotePatterns and allowedDevOrigins.
DOMAIN=localhost
BACK_PORT=1337
IMAGE_HOSTNAME=localhost:1337
BACKEND_URL=http://localhost:1337

# Contact form. The site key is inlined at build time. The others are server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CONTACT_EMAIL_ACCESS_KEY=
CONTACT_EMAIL=
